# Copie para .env (cp .env.example .env). Os valores abaixo funcionam com os quatro
# repositórios clonados lado a lado, como no README.

# Pastas dos módulos, relativas a este repositório
BACKEND1_DIR=../pi4-0102-g6-backend-1
BACKEND2_DIR=../pi4-0102-g6-backend-2
FRONTEND_DIR=../pi4-0102-g6-frontend

# Banco (PostgreSQL). Troque a senha fora da demonstração.
POSTGRES_DB=pi4
POSTGRES_USER=pi4
POSTGRES_PASSWORD=pi4
